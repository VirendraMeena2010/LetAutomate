```gitignore
# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python version
.python-version

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
README.md
# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# MyPy
.mypy_cache/

# Ruff
.ruff_cache/

# Pyright
.pyright/

# Build
build/
dist/
*.egg-info/

# ===========================
# Node.js
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build
.next/
out/
dist/
build/

# ===========================
# IDEs
# ===========================
.vscode/
.idea/

# VS Code workspace
*.code-workspace

# ===========================
